{
  "servers": [
    {
      "name": "filesystem",
      "command": "npx",
      "args": ["@modelcontextprotocol/server-filesystem@2026.7.10", "/workspace/evidence", "/workspace/relay-config"]
    },
    {
      "name": "git",
      "command": "uvx",
      "args": ["--with", "mcp<2", "mcp-server-git==2026.7.10"]
    },
    {
      "name": "code-executor",
      "command": "npx",
      "args": ["@geobio/code_execution_server@0.2.1"],
      "env": {
        "CODE_STORAGE_DIR": "/workspace/scratch",
        "ENV_TYPE": "venv-uv",
        "UV_VENV_PATH": "/workspace/scratch/.venv"
      }
    },
    {
      "name": "calculator",
      "command": "uvx",
      "args": ["--with", "mcp<2", "mcp-server-calculator==0.2.0"]
    }
  ],
  "tool_policy": {
    "required": [
      "filesystem:list_directory",
      "filesystem:read_text_file",
      "git:log",
      "git:show",
      "code-executor:execute_code"
    ],
    "distractors_same_server": [
      "filesystem:search_files",
      "git:status"
    ],
    "distractors_other_server": [
      "calculator:calculate"
    ]
  }
}
