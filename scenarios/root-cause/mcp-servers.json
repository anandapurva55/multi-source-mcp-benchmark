{
  "servers": [
    {
      "name": "filesystem",
      "command": "mcp-server-filesystem",
      "args": [
        "/workspace/evidence",
        "/workspace/relay-config"
      ]
    },
    {
      "name": "git",
      "command": "mcp-server-git",
      "args": []
    },
    {
      "name": "code-executor",
      "command": "mcp_code_execution_server",
      "args": [],
      "env": {
        "CODE_STORAGE_DIR": "/workspace/scratch",
        "ENV_TYPE": "venv-uv",
        "UV_VENV_PATH": "/workspace/scratch/.venv"
      }
    },
    {
      "name": "calculator",
      "command": "mcp-server-calculator",
      "args": []
    }
  ],
  "tool_policy": {
    "required": [
      "filesystem:list_directory",
      "filesystem:read_text_file",
      "git:git_log",
      "git:git_show",
      "code-executor:execute_code"
    ],
    "distractors_same_server": [
      "filesystem:search_files",
      "git:git_status"
    ],
    "distractors_other_server": [
      "calculator:calculate"
    ]
  }
}
